# Pelican reads process environment. Set these in your shell or use node --env-file=.env src/main.js.
# The service:
PELICAN_HOST=127.0.0.1
PELICAN_PORT=4319
# Minutes with nothing running or asked for before the service exits.
# PELICAN_IDLE_MINUTES=5
# PELICAN_DATA_DIR=C:/path/to/pelican-data
# CODEX_BIN=C:/path/to/codex.exe
# Prefer MXC, with serialized elevated setup when MXC is unavailable.
# Explicit alternatives: mxc, elevated, unelevated. Agents always run in Codex auto mode.
# PELICAN_WINDOWS_SANDBOX=auto
# PELICAN_TOKEN=use-a-long-random-secret
# Callers (the CLI, the MCP server, scripts):
# PELICAN_AS=lead
# PELICAN_WORKSPACE=my-workspace-1a2b
# PELICAN_URL=http://127.0.0.1:4319
