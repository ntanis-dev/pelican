{
  "name": "pelican",
  "version": "2.0.0",
  "private": true,
  "license": "MIT",
  "author": "https://github.com/ntanis-dev",
  "description": "A CLI, MCP server and on-demand service through which any orchestrator runs Codex agents.",
  "type": "module",
  "engines": {
    "node": ">=24.0.0"
  },
  "bin": {
    "pelican": "src/cli.js"
  },
  "scripts": {
    "start": "node src/cli.js start",
    "restart": "node src/cli.js restart",
    "dev": "node --watch src/main.js",
    "mcp": "node src/mcp.js",
    "test": "node --test --test-concurrency=1 test/*.test.js",
    "check": "node scripts/check.js",
    "smoke": "node scripts/smoke.js",
    "format": "prettier --write .",
    "lint": "prettier --check ."
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.27.1",
    "ink": "8.0.0",
    "react": "19.3.0",
    "zod": "^4.3.6"
  },
  "devDependencies": {
    "ink-testing-library": "4.0.0",
    "prettier": "3.9.9"
  }
}
